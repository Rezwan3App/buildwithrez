{
  "name": "buildwithrez",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5000",
    "build": "node scripts/pull-content.mjs && vite build --config vite.pages.config.ts && vite build --config vite.pages.config.ts --ssr src/entry-server.tsx --outDir ../dist/server --emptyOutDir && node scripts/prerender.mjs",
    "build:static": "npm run build",
    "preview": "vite preview --port 5000",
    "check": "tsc"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.13.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "5.6.3",
    "vite": "^5.4.19"
  }
}
